APP_NAME=ThemeDetectorTool
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

# Public API v1
# OPTIONAL. At least one of API_KEYS / API_KEY is only required for
# authenticated API access. Comma-separated list of accepted keys (both may
# be set; the accepted set is the union). When set, every request to the
# public API must authenticate with one of these keys via the
# Authorization: Bearer header. When empty, the API is open and rate
# limited per IP. Never commit real keys; provide them via the git-ignored
# .env file or the process environment.
API_KEYS=
# API_KEY=

# OPTIONAL (defaults shown). Anonymous (open) tier: requests / window in
# seconds / IP.
API_ANON_LIMIT=10
API_ANON_WINDOW=900

# OPTIONAL (defaults shown). Authenticated tier: requests / window in
# seconds / API key.
API_KEYED_LIMIT=60
API_KEYED_WINDOW=3600

# OPTIONAL (default shown). API response cache TTL in seconds
# (5-15 minutes recommended).
API_CACHE_TTL=300

# OPTIONAL (default shown). Max concurrent detections across the API
# (0 disables the guard).
API_MAX_CONCURRENT=10

# OPTIONAL (defaults shown). Web detection form (POST /detect): requests /
# window / client IP. A dedicated fixed-window limiter, fully separate from
# the API tiers above (own storage path, namespace, variables). Only
# REMOTE_ADDR is used as the identity; forwarded headers are ignored.
# Conservative defaults because every detection runs a full website analysis.
WEB_DETECT_LIMIT=10
WEB_DETECT_WINDOW=900

# OPTIONAL (default: empty = trust nothing). Comma-separated list of reverse
# proxy IP addresses and/or CIDR blocks (IPv4 or IPv6) that are allowed to
# assert the original request protocol via X-Forwarded-Proto. This is used
# only to decide whether Strict-Transport-Security may be sent when TLS is
# terminated at the proxy. Leave empty when the application is served
# directly, or when the proxy is configured to pass HTTPS=on through to PHP.
# Do not add public/untrusted ranges here: a spoofed X-Forwarded-Proto from an
# untrusted client must never enable HSTS.
TRUSTED_PROXIES=

# OPTIONAL (defaults shown). Structured security logging to
# storage/logs/app.jsonl (JSON Lines). LOG_LEVEL accepts debug, info, notice,
# warning, error, or critical. The default warning keeps informational events
# (such as 404s) out of the file unless the level is lowered.
LOG_ENABLED=true
LOG_LEVEL=warning

# OPTIONAL (default shown). Documentation-only retention target. The
# application does not delete log files automatically; schedule external
# cleanup (logrotate, cron, or your platform's log retention policy) and keep
# the value aligned with that policy.
LOG_RETENTION_DAYS=30

# OPTIONAL (default: empty = omit client identifiers). When set, client IP
# addresses are represented in logs by an HMAC-SHA256 identifier instead of
# the raw address. Use a long random value and keep it secret. Changing the
# key makes previously logged client identifiers non-comparable.
LOG_HASH_KEY=

# OPTIONAL (default shown). Outbound HTTP response-body size cap in bytes.
# Applied to every fetched resource (HTML pages, stylesheets, JSON probes)
# across both HTTP clients. Responses larger than this are failed closed
# and reported as a transport failure.
HTTP_MAX_RESPONSE_BYTES=5242880

# OPTIONAL (default shown). Outbound HTTP response-header size cap in bytes.
# Applied per HTTP hop across both HTTP clients. Header regions larger than
# this are failed closed and reported as a transport failure.
HTTP_MAX_HEADER_BYTES=65536
