APP_NAME=ThemeDetectorTool
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=themedetector
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@globalkernel.com"
MAIL_FROM_NAME="${APP_NAME}"

# Public API v1
# OPTIONAL. At least one of API_KEYS / API_KEY is only required for
# authenticated API access. Comma-separated list of accepted keys (both may
# be set; the accepted set is the union). When set, every request to the
# public API must authenticate with one of these keys via the
# Authorization: Bearer header. When empty, the API is open and rate
# limited per IP. Never commit real keys; provide them via the git-ignored
# .env file or the process environment.
API_KEYS=
# API_KEY=

# OPTIONAL (defaults shown). Anonymous (open) tier: requests / window in
# seconds / IP.
API_ANON_LIMIT=10
API_ANON_WINDOW=900

# OPTIONAL (defaults shown). Authenticated tier: requests / window in
# seconds / API key.
API_KEYED_LIMIT=60
API_KEYED_WINDOW=3600

# OPTIONAL (default shown). API response cache TTL in seconds
# (5-15 minutes recommended).
API_CACHE_TTL=300

# OPTIONAL (default shown). Max concurrent detections across the API
# (0 disables the guard).
API_MAX_CONCURRENT=10

# OPTIONAL (default shown). Outbound HTTP response-body size cap in bytes.
# Applied to every fetched resource (HTML pages, stylesheets, JSON probes)
# across both HTTP clients. Responses larger than this are failed closed
# and reported as a transport failure.
HTTP_MAX_RESPONSE_BYTES=5242880

# OPTIONAL (default shown). Outbound HTTP response-header size cap in bytes.
# Applied per HTTP hop across both HTTP clients. Header regions larger than
# this are failed closed and reported as a transport failure.
HTTP_MAX_HEADER_BYTES=65536
